{
  "rewrites": [
    { "source": "/webgather/windows/latest.yml", "destination": "/webgather/windows/latest.yml" },
    { "source": "/webgather/windows/(.*\\.exe$|.*\\.blockmap$)", "destination": "/webgather/windows/$1" },
    { "source": "/webgather", "destination": "/webgather/windows/" },
    { "source": "/webgather/", "destination": "/webgather/windows/" },
    { "source": "/webgather/windows", "destination": "/webgather/windows/" },
    { "source": "/", "destination": "https://test-1111111111111111111111111111111111711111111111130406.myshopify.com/" },
    { "source": "/(.*)", "destination": "https://test-1111111111111111111111111111111111711111111111130406.myshopify.com/$1" }
  ],
  "headers": [
    {
      "source": "/webgather/windows/latest.yml",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/webgather/windows/(.*\\.exe$|.*\\.blockmap$)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ]
}
